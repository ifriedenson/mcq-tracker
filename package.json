{
  "name": "mcq-tracker",
  "private": true,
  "description": "Obsidian plugin: practice multiple-choice questions kept as notes, with spaced review.",
  "scripts": {
    "build": "node scripts/build.js",
    "build:directory": "node scripts/build.js --directory",
