# main.js is generated by scripts/build.js from src/ and is about 7.3 MB, so it
# is committed (Obsidian installs the plugin from the repository root) but it
# must not be diffed as text: without this every release shows a multi-megabyte
# text diff, and GitHub counts the build output as the repository's main
# language. `npm run check` still proves it matches src/.
main.js binary -diff linguist-generated
